. * --- 9. Regresión por sector y exportación de resultados ---
. 
. levelsof sector, local(sectores) // obtiene los nombres de los sectores y l
> os guarda en una macro local
`"Agricultura"' `"Comercio"' `"Construcción"' `"Educación"' `"Industria"' `"S
> ervicios"'

. 
. local n : word count `sectores' // cuenta cuántos sectores hay

. 
. matrix resultados = J(`n', 3, .) // crea una matriz con una fila por sector
>  y tres columnas para guardar los resultados

. 
. local i = 1 // indica la primera fila de la matriz

. 
. foreach s of local sectores {
  2. 
.     quietly regress `depvar' `educvar' if `sectorvar' == "`s'" // estima la
>  relación entre ingreso y educación para cada sector
  3. 
.     matrix resultados[`i', 1] = _b[`educvar'] // guarda el coeficiente de e
> ducación
  4.     matrix resultados[`i', 2] = _se[`educvar'] // guarda el error estánd
> ar del coeficiente
  5.     matrix resultados[`i', 3] = e(N) // guarda la cantidad de observacio
> nes utilizadas
  6. 
.     local ++i // pasa a la siguiente fila de la matriz
  7. }

. 
. putexcel set "output/tarea_t5_por_sector.xlsx", replace // crea el archivo 
> Excel y reemplaza uno anterior si existe

. 
. putexcel A1=("Sector") B1=("Coeficiente educación") C1=("Error estándar") D
> 1=("Observaciones") // escribe los encabezados de las columnas
file output/tarea_t5_por_sector.xlsx saved

. 
. local i = 2 // indica la segunda fila de Excel, después de los encabezados

. 
. foreach s of local sectores {
  2.     putexcel A`i' = ("`s'") // escribe el nombre del sector
  3.     local ++i // pasa a la siguiente fila de Excel
  4. }
