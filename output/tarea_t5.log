. do "C:\Users\RAGNAR~1\AppData\Local\Temp\STD5680_000000.tmp"

. local datos "data/raw/casen_reducido.csv" // ubicación de la base de datos

. local depvar "ingreso" // variable que quiero analizar

. local numericas "ingreso educ edad experiencia" // variables numericas que us
> are para los descriptivos

. local controles "educ experiencia" // variables que usare como controles en l
> as regresiones 

. local grupos "sector region genero" // grupos que analizare por separado

. 
. global umbral = 500000 // valor de ingreso que usare como referencia para hac
> er un filtro 

. 
. * Usare macros locales para guardar datos que ocupare dentro de este do-file
. * Usare una macro global para el umbral porque también puede utilizarse en ot
> ros do-files
. * De esta forma, si necesito cambiar algún dato puedo hacerlo directamente de
> sde esta sección
. 
. * --- 2. Cargar y preparar los datos ---
. 
. import delimited "`datos'", clear varnames(1) encoding("utf-8") // carga la b
> ase de datos usando la ruta que deje guardada al inicio (local datos)
(6 vars, 60 obs)

. 
. generate experiencia = max(edad - educ - 6, 0) // calcula los años de experie
> ncia, evitando que el resultado sea negativo

. 
. label variable experiencia "Experiencia potencial (años)" // agrega una descr
> ipción a la variable

. 
. generate mujer = (genero == "F") if !missing(genero) // crea una variable que
>  identifica con 1 a las mujeres y con 0 a los hombres

. 
. label variable mujer "Mujer (1 = sí)" // agrega una descripción a la variable

. 
. label define mujer_etiqueta 0 "Hombre" 1 "Mujer" // define los nombres que te
> ndrá cada valor

. 
. label values mujer mujer_etiqueta // asigna los nombres anteriores a la varia
> ble mujer

. 
. describe, short // muestra cuántas observaciones y variables tiene la base

